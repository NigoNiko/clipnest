{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipNest",
  "version": "0.1.0",
  "identifier": "com.clipnest.app",
  "build": {
    "frontendDist": "../../clipnest-prototype"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ClipNest",
        "width": 1728,
        "height": 330,
        "minWidth": 820,
        "minHeight": 220,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}

